{
  "name": "@fortuneness/fortune-content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Versioned Fortuneness card and fortune content with release validation.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "review:print": "tsx src/print-review-report.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "tsx src/validate.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.20.5"
  }
}
