{
  "openapi": "3.1.0",
  "info": {
    "title": "Fortuneness API",
    "version": "0.1.0",
    "description": "Server-authoritative contracts for the Fortuneness iPhone and iPad application."
  },
  "servers": [{ "url": "/" }],
  "tags": [
    { "name": "Operations" },
    { "name": "Authentication" },
    { "name": "Account" },
    { "name": "Fortunes" }
  ],
  "x-stable-error-codes": [
    "VALIDATION_FAILED",
    "AUTH_REQUIRED",
    "GAME_CENTER_REAUTH_REQUIRED",
    "GAME_CENTER_UNAVAILABLE",
    "GAME_CENTER_ID_NOT_PERSISTENT",
    "GAME_CENTER_PROOF_INVALID",
    "GAME_CENTER_PROOF_EXPIRED",
    "ACCOUNT_DELETION_PENDING",
    "ACCOUNT_PURGED",
    "NOT_FOUND",
    "NO_DRAWS_AVAILABLE",
    "UNVIEWED_READING_PENDING",
    "CONTENT_UNAVAILABLE",
    "PRODUCT_NOT_ALLOWED",
    "TRANSACTION_UNVERIFIED",
    "TRANSACTION_OWNER_UNKNOWN",
    "COMMERCE_REVIEW_REQUIRED",
    "IDEMPOTENCY_KEY_REUSED",
    "TIME_ZONE_CHANGE_LIMITED",
    "RETRYABLE_CONFLICT",
    "RATE_LIMITED",
    "INTERNAL_ERROR"
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "checks": {
            "type": "object",
            "properties": {
              "database": { "type": "string", "enum": ["ready", "not_ready"] },
              "process": { "type": "string", "enum": ["ready", "not_ready"] }
            },
            "required": ["database", "process"],
            "additionalProperties": false
          },
          "status": { "type": "string", "enum": ["ready", "not_ready"] }
        },
        "required": ["checks", "status"],
        "additionalProperties": false
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": { "error": { "$ref": "#/components/schemas/ApiError" } },
        "required": ["error"],
        "additionalProperties": false
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "AUTH_REQUIRED",
              "GAME_CENTER_REAUTH_REQUIRED",
              "GAME_CENTER_UNAVAILABLE",
              "GAME_CENTER_ID_NOT_PERSISTENT",
              "GAME_CENTER_PROOF_INVALID",
              "GAME_CENTER_PROOF_EXPIRED",
              "ACCOUNT_DELETION_PENDING",
              "ACCOUNT_PURGED",
              "NOT_FOUND",
              "NO_DRAWS_AVAILABLE",
              "UNVIEWED_READING_PENDING",
              "CONTENT_UNAVAILABLE",
              "PRODUCT_NOT_ALLOWED",
              "TRANSACTION_UNVERIFIED",
              "TRANSACTION_OWNER_UNKNOWN",
              "COMMERCE_REVIEW_REQUIRED",
              "IDEMPOTENCY_KEY_REUSED",
              "TIME_ZONE_CHANGE_LIMITED",
              "RETRYABLE_CONFLICT",
              "RATE_LIMITED",
              "INTERNAL_ERROR"
            ]
          },
          "message": { "type": "string", "minLength": 1 },
          "requestId": { "type": "string", "format": "uuid" },
          "retryable": { "type": "boolean" },
          "sameKeyRetrySafe": { "type": "boolean" }
        },
        "required": ["code", "message", "requestId", "retryable", "sameKeyRetrySafe"],
        "additionalProperties": false
      },
      "GameCenterAuthResponse": {
        "type": "object",
        "properties": {
          "user": { "$ref": "#/components/schemas/AuthenticatedUser" },
          "session": { "$ref": "#/components/schemas/SessionTokens" },
          "bootstrap": { "$ref": "#/components/schemas/AccountBootstrap" }
        },
        "required": ["user", "session", "bootstrap"],
        "additionalProperties": false
      },
      "AuthenticatedUser": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "DELETION_PENDING", "PURGED", "BLOCKED"]
          },
          "resolvedLocale": { "type": "string", "enum": ["en"] },
          "accountTimeZone": { "type": "string", "minLength": 1, "maxLength": 128 },
          "pendingTimeZone": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
          "timeZoneEffectiveAt": { "type": ["string", "null"], "format": "date-time" },
          "nextTimeZoneChangeEligibleAt": { "type": ["string", "null"], "format": "date-time" },
          "onboardingCompletedAt": { "type": ["string", "null"], "format": "date-time" },
          "preferences": { "$ref": "#/components/schemas/UserPreferences" }
        },
        "required": [
          "id",
          "status",
          "resolvedLocale",
          "accountTimeZone",
          "pendingTimeZone",
          "timeZoneEffectiveAt",
          "nextTimeZoneChangeEligibleAt",
          "onboardingCompletedAt",
          "preferences"
        ],
        "additionalProperties": false
      },
      "UserPreferences": {
        "type": "object",
        "properties": {
          "reminderEnabled": { "type": "boolean" },
          "reminderLocalMinutes": { "type": "integer", "minimum": 0, "maximum": 1439 },
          "soundEnabled": { "type": "boolean" },
          "hapticsEnabled": { "type": "boolean" },
          "reduceMotionPreferred": { "type": "boolean" }
        },
        "required": [
          "reminderEnabled",
          "reminderLocalMinutes",
          "soundEnabled",
          "hapticsEnabled",
          "reduceMotionPreferred"
        ],
        "additionalProperties": false
      },
      "SessionTokens": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string", "minLength": 32, "maxLength": 4096 },
          "refreshToken": { "type": "string", "minLength": 32, "maxLength": 512 },
          "accessTokenExpiresAt": { "type": "string", "format": "date-time" },
          "refreshTokenExpiresAt": { "type": "string", "format": "date-time" },
          "authTime": { "type": "string", "format": "date-time" }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "accessTokenExpiresAt",
          "refreshTokenExpiresAt",
          "authTime"
        ],
        "additionalProperties": false
      },
      "AccountBootstrap": {
        "type": "object",
        "properties": {
          "serverTime": { "type": "string", "format": "date-time" },
          "reportedDeviceLocale": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35,
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$/u"
          },
          "reportedDeviceTimeZone": { "type": "string", "minLength": 1, "maxLength": 128 },
          "appAccountToken": { "type": "string", "format": "uuid" }
        },
        "required": [
          "serverTime",
          "reportedDeviceLocale",
          "reportedDeviceTimeZone",
          "appAccountToken"
        ],
        "additionalProperties": false
      },
      "GameCenterAuthRequest": {
        "type": "object",
        "properties": {
          "proof": { "$ref": "#/components/schemas/GameCenterProof" },
          "scopedIdsPersistent": { "type": "boolean" },
          "alias": { "type": "string", "minLength": 1, "maxLength": 128 },
          "restrictions": { "$ref": "#/components/schemas/GameCenterRestrictions" },
          "reportedDeviceLocale": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35,
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$/u"
          },
          "reportedDeviceTimeZone": { "type": "string", "minLength": 1, "maxLength": 128 },
          "device": { "$ref": "#/components/schemas/AuthDevice" }
        },
        "required": [
          "proof",
          "scopedIdsPersistent",
          "alias",
          "restrictions",
          "reportedDeviceLocale",
          "reportedDeviceTimeZone",
          "device"
        ],
        "additionalProperties": false
      },
      "GameCenterProof": {
        "type": "object",
        "properties": {
          "teamPlayerId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "gamePlayerId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "bundleId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9]+(?:[.-][A-Za-z0-9]+)+$/u"
          },
          "publicKeyUrl": { "type": "string", "maxLength": 2048, "format": "uri" },
          "signatureBase64": {
            "type": "string",
            "minLength": 4,
            "maxLength": 8192,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/u"
          },
          "saltBase64": {
            "type": "string",
            "minLength": 4,
            "maxLength": 8192,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/u"
          },
          "timestamp": { "type": "string", "pattern": "^\\d{1,20}$/u" }
        },
        "required": [
          "teamPlayerId",
          "gamePlayerId",
          "bundleId",
          "publicKeyUrl",
          "signatureBase64",
          "saltBase64",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "GameCenterRestrictions": {
        "type": "object",
        "properties": {
          "isUnderage": { "type": "boolean" },
          "isMultiplayerGamingRestricted": { "type": "boolean" },
          "isPersonalizedCommunicationRestricted": { "type": "boolean" }
        },
        "required": [
          "isUnderage",
          "isMultiplayerGamingRestricted",
          "isPersonalizedCommunicationRestricted"
        ],
        "additionalProperties": false
      },
      "AuthDevice": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "description": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "RefreshSessionResponse": {
        "type": "object",
        "properties": { "session": { "$ref": "#/components/schemas/SessionTokens" } },
        "required": ["session"],
        "additionalProperties": false
      },
      "RefreshSessionRequest": {
        "type": "object",
        "properties": {
          "refreshToken": { "type": "string", "minLength": 32, "maxLength": 512 },
          "device": { "$ref": "#/components/schemas/AuthDevice" }
        },
        "required": ["refreshToken", "device"],
        "additionalProperties": false
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "user": { "$ref": "#/components/schemas/AuthenticatedUser" },
          "bootstrap": { "$ref": "#/components/schemas/AccountBootstrap" }
        },
        "required": ["user", "bootstrap"],
        "additionalProperties": false
      },
      "FortuneStateResponse": {
        "type": "object",
        "properties": {
          "state": { "$ref": "#/components/schemas/FortuneAllowanceState" },
          "unviewedDraw": { "$ref": "#/components/schemas/FortuneDraw" }
        },
        "required": ["state", "unviewedDraw"],
        "additionalProperties": false
      },
      "FortuneAllowanceState": {
        "type": "object",
        "properties": {
          "serverTime": { "type": "string", "format": "date-time" },
          "freeRemaining": { "type": "integer", "minimum": 0, "maximum": 1 },
          "subscriptionRemaining": { "type": "integer", "minimum": 0, "maximum": 10 },
          "spendablePackCredits": { "type": "integer", "minimum": 0 },
          "availableDraws": { "type": "integer", "minimum": 0 },
          "allowancePeriodId": { "type": "string", "format": "uuid" },
          "currentPeriodStartedAt": { "type": "string", "format": "date-time" },
          "nextResetAt": { "type": "string", "format": "date-time" },
          "accountTimeZone": { "type": "string", "minLength": 1, "maxLength": 128 },
          "reportedDeviceTimeZone": { "type": "string", "minLength": 1, "maxLength": 128 },
          "pendingTimeZone": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
          "timeZoneEffectiveAt": { "type": ["string", "null"], "format": "date-time" },
          "nextTimeZoneChangeEligibleAt": { "type": ["string", "null"], "format": "date-time" },
          "subscription": { "$ref": "#/components/schemas/SubscriptionAllowance" }
        },
        "required": [
          "serverTime",
          "freeRemaining",
          "subscriptionRemaining",
          "spendablePackCredits",
          "availableDraws",
          "allowancePeriodId",
          "currentPeriodStartedAt",
          "nextResetAt",
          "accountTimeZone",
          "reportedDeviceTimeZone",
          "pendingTimeZone",
          "timeZoneEffectiveAt",
          "nextTimeZoneChangeEligibleAt",
          "subscription"
        ],
        "additionalProperties": false
      },
      "SubscriptionAllowance": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["NONE", "ACTIVE", "GRACE_PERIOD", "BILLING_RETRY", "EXPIRED", "REVOKED"]
          },
          "entitled": { "type": "boolean" },
          "paidThrough": { "type": ["string", "null"], "format": "date-time" },
          "graceThrough": { "type": ["string", "null"], "format": "date-time" }
        },
        "required": ["status", "entitled", "paidThrough", "graceThrough"],
        "additionalProperties": false
      },
      "FortuneDraw": {
        "type": ["object", "null"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "cardKey": { "type": "string", "minLength": 1, "maxLength": 48 },
          "cardDisplayNumber": { "type": "string", "minLength": 1, "maxLength": 16 },
          "cardName": { "type": "string", "minLength": 1, "maxLength": 80 },
          "orientation": { "$ref": "#/components/schemas/FortuneOrientation" },
          "intention": { "$ref": "#/components/schemas/FortuneIntention" },
          "resolvedLocale": { "type": "string", "minLength": 2, "maxLength": 16 },
          "artAltText": { "type": "string", "minLength": 1, "maxLength": 500 },
          "headline": { "type": "string", "minLength": 1, "maxLength": 120 },
          "message": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "action": { "type": "string", "minLength": 1, "maxLength": 500 },
          "affirmation": { "type": "string", "minLength": 1, "maxLength": 300 },
          "allowanceSource": { "$ref": "#/components/schemas/AllowanceSource" },
          "contentVersion": { "type": "string", "minLength": 1, "maxLength": 48 },
          "issuedAt": { "type": "string", "format": "date-time" },
          "viewedAt": { "type": ["string", "null"], "format": "date-time" }
        },
        "required": [
          "id",
          "cardKey",
          "cardDisplayNumber",
          "cardName",
          "orientation",
          "intention",
          "resolvedLocale",
          "artAltText",
          "headline",
          "message",
          "action",
          "affirmation",
          "allowanceSource",
          "contentVersion",
          "issuedAt",
          "viewedAt"
        ],
        "additionalProperties": false
      },
      "FortuneOrientation": { "type": "string", "enum": ["UPRIGHT", "REVERSED"] },
      "FortuneIntention": { "type": "string", "enum": ["GENERAL", "LOVE", "WORK", "GROWTH"] },
      "AllowanceSource": {
        "type": "string",
        "enum": ["FREE_DAILY", "SUBSCRIPTION_DAILY", "PACK_CREDIT"]
      },
      "FortuneDrawResponse": {
        "type": "object",
        "properties": {
          "draw": { "$ref": "#/components/schemas/FortuneDraw" },
          "state": { "$ref": "#/components/schemas/FortuneAllowanceState" }
        },
        "required": ["draw", "state"],
        "additionalProperties": false
      },
      "FortuneDrawRequest": {
        "type": "object",
        "properties": { "intention": { "$ref": "#/components/schemas/FortuneIntention" } },
        "required": ["intention"],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "description": "Reports only process and PostgreSQL readiness. It never returns versions, URLs, credentials, or dependency errors.",
        "summary": "Check API readiness",
        "tags": ["Operations"],
        "responses": {
          "200": {
            "description": "The process is accepting traffic and PostgreSQL is reachable.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          },
          "500": {
            "description": "An unexpected server failure occurred.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "503": {
            "description": "The process is draining or PostgreSQL is unavailable.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          }
        }
      }
    },
    "/v1/auth/game-center": {
      "post": {
        "description": "Verifies a fresh, persistent Game Center identity proof and returns authoritative account bootstrap and rotating session tokens.",
        "summary": "Authenticate with Game Center",
        "tags": ["Authentication"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GameCenterAuthRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The proof was verified and an active session was issued.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GameCenterAuthResponse" }
              }
            }
          },
          "400": {
            "description": "The proof or advisory device context is malformed.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "401": {
            "description": "The proof is invalid, stale, or signed for another bundle.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "409": {
            "description": "The player identifiers are not persistent.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "410": {
            "description": "A stale retained identity points at an already purged account.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "423": {
            "description": "The account is pending deletion and no normal session was issued.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "503": {
            "description": "Apple proof verification or stable database state is temporarily unavailable.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "description": "Atomically consumes one refresh token and returns exactly one replacement. Exact same-key retries may replay the encrypted receipt for up to 120 seconds.",
        "summary": "Rotate a session",
        "tags": ["Authentication"],
        "parameters": [
          {
            "schema": { "type": "string", "format": "uuid" },
            "required": true,
            "name": "Idempotency-Key",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshSessionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The refresh token was rotated or an exact replay was returned.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RefreshSessionResponse" }
              }
            }
          },
          "400": {
            "description": "The request or idempotency key is malformed.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "401": {
            "description": "The refresh token or session family is invalid.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "409": {
            "description": "The idempotency key was reused for different input.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "410": {
            "description": "The account has already been purged.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "423": {
            "description": "The account entered deletion pending before refresh could commit.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "503": {
            "description": "Stable database state is temporarily unavailable.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "description": "Revokes the current refresh-token family after authoritative session checks.",
        "summary": "Log out the current session",
        "tags": ["Authentication"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "The current session family was revoked." },
          "401": {
            "description": "The access token or authoritative session is no longer active.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "410": {
            "description": "The account was purged before logout could commit.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "423": {
            "description": "The account entered deletion pending before logout could commit.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "503": {
            "description": "Stable database state is temporarily unavailable.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "description": "Returns authoritative account preferences and bootstrap context.",
        "summary": "Get the active account",
        "tags": ["Account"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "The active account and current bootstrap context.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MeResponse" } }
            }
          },
          "401": {
            "description": "The access token or authoritative session is no longer active.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "410": {
            "description": "The account was purged before bootstrap could commit.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "423": {
            "description": "The account is pending deletion.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/v1/fortune/state": {
      "get": {
        "description": "Returns server-clock allowance, subscription, monotonic period, time-zone, pack-credit, and resumable-reading state.",
        "summary": "Get authoritative fortune state",
        "tags": ["Fortunes"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "The active account fortune state and any owned unviewed reading.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FortuneStateResponse" }
              }
            }
          },
          "401": {
            "description": "The access token or authoritative session is no longer active.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "410": {
            "description": "The account has already been purged.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "423": {
            "description": "The account is pending deletion.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } }
            }
          },
          "503": {
            "description": "Stable database state is temporarily unavailable.",
            "content": {
