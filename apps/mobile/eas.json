{
  "cli": {
    "version": ">= 21.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.18.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_ENABLE_PSEUDO_LOCALE": "true"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_ENABLE_PSEUDO_LOCALE": "true"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_ENABLE_PSEUDO_LOCALE": "false",
        "EXPO_PUBLIC_API_URL": "https://fortuneapp-production.up.railway.app",
        "EXPO_PUBLIC_PRIVACY_URL": "https://fortuneapp-production.up.railway.app/privacy",
        "EXPO_PUBLIC_TERMS_URL": "https://fortuneapp-production.up.railway.app/terms",
        "EXPO_PUBLIC_SUPPORT_URL": "https://fortuneapp-production.up.railway.app/support",
        "APP_BUNDLE_ID": "fortuness.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
