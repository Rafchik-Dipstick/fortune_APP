require "fileutils"

default_platform(:ios)

def required_environment(name)
  value = ENV[name].to_s.strip
  UI.user_error!("Missing required environment variable #{name}") if value.empty?
  value
end

platform :ios do
  desc "Upload App Store metadata without changing screenshots or the binary"
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id: required_environment("ASC_KEY_ID"),
      issuer_id: required_environment("ASC_ISSUER_ID"),
      key_content: required_environment("ASC_API_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    deliver(
      api_key: api_key,
      app_identifier: "fortuness.app",
      app_version: "0.2.0",
      platform: "ios",
      metadata_path: File.expand_path("metadata", __dir__),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      skip_app_version_update: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Upload validated App Store metadata and screenshots without changing the binary"
  lane :screenshots do
    api_key = app_store_connect_api_key(
      key_id: required_environment("ASC_KEY_ID"),
      issuer_id: required_environment("ASC_ISSUER_ID"),
      key_content: required_environment("ASC_API_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    deliver(
      api_key: api_key,
      app_identifier: "fortuness.app",
      app_version: "0.2.0",
      platform: "ios",
      screenshots_path: File.expand_path("../build/app-store-screenshots", __dir__),
      skip_binary_upload: true,
      metadata_path: File.expand_path("metadata", __dir__),
      skip_metadata: false,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true
    )
  end

  desc "Build Fortuneness and upload it directly to TestFlight"
  lane :testflight do
    bundle_identifier = "fortuness.app"
    app_store_id = "6799167588"
    team_id = required_environment("APPLE_TEAM_ID")
    certificate_id = required_environment("IOS_DISTRIBUTION_CERTIFICATE_ID")
    build_number = required_environment("IOS_BUILD_NUMBER")

    UI.user_error!("IOS_BUILD_NUMBER must contain only digits") unless build_number.match?(/\A[1-9][0-9]*\z/)

    api_key = app_store_connect_api_key(
      key_id: required_environment("ASC_KEY_ID"),
      issuer_id: required_environment("ASC_ISSUER_ID"),
      key_content: required_environment("ASC_API_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    profile_directory = File.expand_path("../build/signing", __dir__)
    FileUtils.mkdir_p(profile_directory)

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: bundle_identifier,
      team_id: team_id,
      cert_id: certificate_id,
      force: true,
      provisioning_name: "Fortuneness GitHub App Store",
      filename: "Fortuneness_AppStore.mobileprovision",
      output_path: profile_directory,
      skip_install: false
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_uuid = lane_context[SharedValues::SIGH_UUID]
    UI.user_error!("Apple did not return a provisioning-profile name") if profile_name.to_s.empty?
    UI.user_error!("Apple did not return a provisioning-profile UUID") if profile_uuid.to_s.empty?

    native_directory = File.expand_path("../ios", __dir__)
    project = Dir[File.join(native_directory, "*.xcodeproj")].first
    workspace = Dir[File.join(native_directory, "*.xcworkspace")].first
    UI.user_error!("Expo prebuild did not generate an Xcode project") unless project
    UI.user_error!("CocoaPods did not generate an Xcode workspace") unless workspace

    scheme = File.basename(project, ".xcodeproj")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: project,
      team_id: team_id,
      targets: [scheme],
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      profile_uuid: profile_uuid,
      bundle_identifier: bundle_identifier
    )

    ipa = build_app(
      workspace: workspace,
      scheme: scheme,
      configuration: "Release",
      clean: true,
      destination: "generic/platform=iOS",
      output_directory: File.expand_path("../build/ios", __dir__),
      output_name: "Fortuneness.ipa",
      export_method: "app-store",
      export_team_id: team_id,
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} DEVELOPMENT_TEAM=#{team_id}",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          bundle_identifier => profile_name
        },
        uploadSymbols: true
      }
    )

    upload_options = {
      api_key: api_key,
      ipa: ipa,
      app_identifier: bundle_identifier,
      apple_id: app_store_id,
      skip_submission: true,
      skip_waiting_for_build_processing: true,
      notify_external_testers: false,
      uses_non_exempt_encryption: false
    }

    changelog = ENV["TESTFLIGHT_CHANGELOG"].to_s.strip
    upload_options[:changelog] = changelog unless changelog.empty?

    upload_to_testflight(**upload_options)
  end
end
