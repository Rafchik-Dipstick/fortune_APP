# Public values are embedded in the app binary. Never place secrets here.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_ENABLE_PSEUDO_LOCALE=true
EXPO_PUBLIC_LOCALE_OVERRIDE=

# Native build-time value. Development/preview defaults are available locally;
# production intentionally fails closed until the Phase 0 bundle ID is confirmed.
APP_BUNDLE_ID=app.fortuneness.dev
