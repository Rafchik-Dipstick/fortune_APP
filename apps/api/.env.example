NODE_ENV=development
DEPLOYMENT_ENVIRONMENT=local
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fortuneness
TRUST_PROXY=0
CORS_ORIGINS=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_LOCK_TIMEOUT_MS=5000
REQUEST_TIMEOUT_MS=15000
OUTBOUND_REQUEST_TIMEOUT_MS=5000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTHENTICATION_MAX=20
RATE_LIMIT_DRAW_MAX=30
RATE_LIMIT_WEBHOOK_MAX=600
# Must equal the bundle identifier of the build that talks to this API, because
# a Game Center proof is rejected when the two disagree. The development build
# profile resolves to app.fortuneness.dev2; preview uses app.fortuneness.preview.
APP_BUNDLE_ID=app.fortuneness.dev2
APP_APPLE_ID=
GAME_CENTER_IDENTITY_HMAC_KEYS_JSON={"v1":"replace-with-base64-key"}
GAME_CENTER_IDENTITY_CURRENT_KEY_VERSION=v1
GAME_CENTER_ALLOWED_PUBLIC_KEY_HOSTS=static.gc.apple.com
GAME_CENTER_ALLOWED_CERTIFICATE_HOSTS=cacerts.digicert.com
# Game Center gives sandbox players temporary scoped identifiers, and every
# build that is not from TestFlight or the App Store is a sandbox player. This
# accepts them so a development build can sign in. The API refuses this setting
# unless DEPLOYMENT_ENVIRONMENT is local.
GAME_CENTER_ALLOW_NONPERSISTENT_IDS=true
GAME_CENTER_PROOF_MAX_AGE_SECONDS=300
GAME_CENTER_PROOF_CLOCK_SKEW_SECONDS=60
JWT_ACCESS_KEYS_JSON={"v1":"replace-with-base64-key"}
JWT_ACCESS_CURRENT_KEY_VERSION=v1
JWT_ISSUER=fortuneness-api
JWT_AUDIENCE=fortuneness-mobile
REFRESH_TOKEN_HMAC_KEYS_JSON={"v1":"replace-with-base64-key"}
REFRESH_TOKEN_CURRENT_KEY_VERSION=v1
REFRESH_REPLAY_ENCRYPTION_KEYS_JSON={"v1":"replace-with-base64-key"}
REFRESH_REPLAY_CURRENT_KEY_VERSION=v1
APP_ACCOUNT_TOKEN_HMAC_KEYS_JSON={"v1":"replace-with-base64-key"}
APP_ACCOUNT_TOKEN_HMAC_CURRENT_KEY_VERSION=v1
APP_ACCOUNT_TOKEN_ENCRYPTION_KEYS_JSON={"v1":"replace-with-base64-key"}
APP_ACCOUNT_TOKEN_ENCRYPTION_CURRENT_KEY_VERSION=v1
HISTORY_CURSOR_HMAC_KEYS_JSON={"v1":"replace-with-base64-key"}
HISTORY_CURSOR_CURRENT_KEY_VERSION=v1
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ACCOUNT_DELETION_REAUTH_MAX_AGE_SECONDS=300
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY_BASE64=
APPLE_IAP_ENVIRONMENT=SANDBOX
APP_STORE_NOTIFICATION_ENCRYPTION_KEYS_JSON={"v1":"replace-with-base64-key"}
APP_STORE_NOTIFICATION_CURRENT_KEY_VERSION=v1
APP_STORE_NOTIFICATION_RAW_TTL_DAYS=90
APPLE_CONSUMPTION_INFO_ENABLED=false
IAP_FORTUNE_PACK_10_PRODUCT_ID=app.fortuneness.fortunepack10
IAP_ORACLE_PLUS_MONTHLY_PRODUCT_ID=app.fortuneness.oracleplus.monthly
IAP_ORACLE_PLUS_MONTHLY_EXPECTED_BILLING_PLAN_TYPE=
SENTRY_DSN=
SENTRY_RELEASE=
METRICS_FLUSH_INTERVAL_MS=60000
LOG_LEVEL=info
