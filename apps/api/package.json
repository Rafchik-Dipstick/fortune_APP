{
  "name": "@fortuneness/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fortuneness Node.js API for Railway.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env src/main.ts",
    "dev:env": "node scripts/create-dev-env.mjs",
    "dev:setup": "npm run dev:env && node scripts/create-dev-database.mjs && npm run db:migrate:deploy && npm run db:seed",
    "dev:grant": "tsx --env-file=.env scripts/grant-dev-draws.ts",
    "db:create": "node scripts/create-dev-database.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:invariants": "node scripts/check-database-invariants.mjs",
    "load-test": "node scripts/load-test.mjs",
    "db:schema:format": "prisma format",
    "db:schema:validate": "prisma validate",
    "db:seed": "prisma generate && prisma db seed",
    "prisma:generate": "prisma generate",
    "start": "node dist/main.js",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:db": "node scripts/run-database-tests.mjs",
    "test:db:integration": "vitest run --no-file-parallelism src/account/deletion.integration.test.ts src/content/content-seed.integration.test.ts src/db/database.integration.test.ts src/fortune/archive.integration.test.ts src/fortune/monetized-allowance.integration.test.ts src/iap/application.integration.test.ts src/iap/notifications.integration.test.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json && tsc -p prisma/tsconfig.json && tsc -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@fortuneness/api-contracts": "0.0.0",
    "@fortuneness/fortune-content": "0.0.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "jose": "6.2.8",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/pg": "8.20.4",
    "@types/supertest": "7.2.1",
    "dotenv": "17.4.2",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsx": "4.20.5"
  }
}
