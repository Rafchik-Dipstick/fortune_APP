{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "corepack npm run build --workspace @fortuneness/api-contracts --workspace @fortuneness/fortune-content --workspace @fortuneness/api",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/api-contracts/**",
      "/packages/fortune-content/**",
      "/package.json",
      "/package-lock.json",
      "/tsconfig.base.json"
    ]
  },
  "deploy": {
    "startCommand": "corepack npm run start --workspace @fortuneness/api",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 20,
    "drainingSeconds": 15
  }
}
