{
  "name": "fortuneness",
  "version": "0.0.0",
  "private": true,
  "description": "Fortuneness iPhone/iPad app and Railway API monorepo.",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.12.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run config:check && npm run typecheck && npm run test && npm run content:validate && npm run asset:validate && npm run brand:validate && npm run build",
    "brand:validate": "node tools/brand-assets/validate.mjs",
    "config:check": "npm run config:check --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "content:validate": "npm run validate --workspace @fortuneness/fortune-content",
    "asset:validate": "node tools/card-assets/validate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
