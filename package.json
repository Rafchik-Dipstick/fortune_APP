{
  "name": "fortuneness",
  "version": "0.0.0",
  "private": true,
  "description": "Fortuneness iPhone/iPad app and Railway API monorepo.",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.12.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run config:check && npm run db:schema:validate && npm run typecheck && npm run test && npm run openapi:check && npm run content:validate && npm run asset:validate && npm run asset:audio:validate && npm run brand:validate && npm run build && npm run asset:budget",
    "brand:validate": "node tools/brand-assets/validate.mjs",
    "config:check": "npm run config:check --workspaces --if-present",
    "db:schema:validate": "npm run db:schema:validate --workspace @fortuneness/api",
    "test:db": "npm run test:db --workspace @fortuneness/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "openapi:check": "npm run openapi:check --workspace @fortuneness/api-contracts",
    "openapi:generate": "npm run openapi:generate --workspace @fortuneness/api-contracts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "content:validate": "npm run validate --workspace @fortuneness/fortune-content",
    "content:review": "npm run review:print --workspace @fortuneness/fortune-content",
    "asset:prompts": "node tools/card-assets/build-full-deck-prompts.mjs",
    "asset:normalize": "python tools/card-assets/normalize.py",
    "asset:sync": "node tools/card-assets/sync-manifest.mjs",
    "asset:shipping": "python tools/card-assets/encode-shipping.py",
    "asset:validate": "node tools/card-assets/validate.mjs",
    "asset:budget": "node tools/bundle-budget/validate.mjs",
    "asset:audio": "node tools/audio-assets/generate.mjs",
    "asset:audio:validate": "node tools/audio-assets/validate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "prisma@7.9.1": true
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
